#!/usr/bin/env python3
"""Super Puppy — UserPromptSubmit hook.

When a prompt looks like reconnaissance / context-gathering (understand this
code, where is X, summarize this log, explore this dir), inject a reminder to
offload the heavy reading to the local GPU cluster (the `recon-local` subagent /
local_summarize / local_similarity_search) instead of ingesting raw files at
frontier-token cost.

It is a *nudge*, not a gate: it never blocks the prompt, always exits 0, and
stays silent on anything that isn't clearly recon-shaped (so it can't get in the
way of editing, which needs exact bytes and must stay on the frontier model).
"""
import json
import re
import sys

# Deliberately conservative — match exploration/understanding, not editing.
_RECON = re.compile(
    r"\b("
    r"how (does|do|is|are)\b|where (is|are|does)\b|what does\b|"
    r"understand(ing)?\b|explain\b|walk me through\b|give me (an )?overview\b|"
    r"explore\b|reconnaissance\b|trace through\b|"
    r"summar(ize|y|ise)\b|read (through )?(the|this)\b|skim\b|"
    r"which files\b|find (the )?(files?|code|where)\b|locate\b|"
    r"map (out )?(the|this)\b|what('| i)?s in\b"
    r")",
    re.IGNORECASE,
)
# Suppress on clear edit/action intent — those need exact bytes on the frontier model.
_EDIT = re.compile(
    r"\b(edit|change|fix|refactor|rename|implement|add (a|the)\b|write (a|the)\b|"
    r"delete|remove|replace|update the|patch|commit|push|run the|install)\b",
    re.IGNORECASE,
)
# Suppress on non-genuine-prompt turns: system notifications, tool/hook plumbing,
# and our OWN injected nudge text (which contains "reconnaissance" and would
# otherwise re-trigger the hook on itself). This is what made it fire on a
# task-notification turn.
_NOT_A_PROMPT = re.compile(
    r"\[SYSTEM NOTIFICATION|</?task-notification>|automated background-task|"
    r"this prompt looks like reconnaissance \(understanding",  # our own injected nudge
    re.IGNORECASE,
)

_MSG = (
    "This prompt looks like reconnaissance (understanding/exploring code or "
    "summarizing large content). Prefer offloading the heavy reading to the local "
    "GPU cluster before ingesting raw files at frontier cost: delegate to the "
    "`recon-local` subagent, or call local_summarize / local_similarity_search "
    "directly, and read the digest instead of the raw material. Skip this if you "
    "actually need exact bytes to edit."
)


def main() -> int:
    try:
        data = json.load(sys.stdin)
        prompt = str(data.get("prompt", "")) if isinstance(data, dict) else ""
    except Exception:
        return 0  # fail open — never block the prompt
    if not prompt:
        return 0
    if _NOT_A_PROMPT.search(prompt):
        return 0  # system/hook/injected text — not a genuine recon request
    if _RECON.search(prompt) and not _EDIT.search(prompt):
        json.dump(
            {"hookSpecificOutput": {
                "hookEventName": "UserPromptSubmit",
                "additionalContext": _MSG,
            }},
            sys.stdout,
        )
    return 0


if __name__ == "__main__":
    sys.exit(main())
